 },
 "cholula_holy_city_desc": {
  "en": "The Great Pyramid of [ShowLocationName('cholollan')] was built in successive stages during hundreds of years. Dedicated to the deity [ShowGodName('quetzalcoatl_god')], it is the largest pyramid in the region. Even after the city's decline, it remained a sacred and cultural site for local inhabitants.",
  "uk": "Велика піраміда #TOOLTIP:LOCATION,cholollan,X #L Чололяна#!#! зводилася поетапно протягом кількох століть. Побудована як святилище бога #TOOLTIP:GOD,quetzalcoatl_god,X #L Кетцалькоатля#!#!, вона є найбільшою пірамідою регіону. Навіть після падіння міста храм продовжував відігравати важливу роль у духовному житті місцевого населення."
 },
