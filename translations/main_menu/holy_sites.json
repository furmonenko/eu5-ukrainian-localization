 "temple_of_confucius_desc": {
  "en": "The $temple_of_confucius$ in [ShowLocationName('qufu')], was originally built in 478 BC to honor the philosopher Confucius. Expanded repeatedly during successive dynasties, it became one of the largest temple complexes in China.",
  "uk": "$temple_of_confucius$ в #TOOLTIP:LOCATION,qufu,X #L Цюйфу#!#! було збудовано у 478 році до н. е. на честь знаменитого філософа Конфуція. Наступні династії неодноразово розширювали святилище, поки воно не перетворилося на один із найбільших храмових комплексів на території Китаю."
 },
